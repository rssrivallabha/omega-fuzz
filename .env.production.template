# Omega Fuzz Production Compute Backend Environment Template (Railway / Render / Docker VPS)
PORT=3001
NODE_ENV=production

# Enable local safe sandbox execution inside persistent container runtime
OMEGA_ALLOW_UNSAFE_LOCAL_EXECUTION=true

# Campaign retention time before automatic memory eviction (default 1 hour in milliseconds)
CAMPAIGN_RETENTION_MS=3600000

# (Optional) Redis message broker URL for multi-worker deployment scaling
# REDIS_BROKER_URL=redis://localhost:6379

# (Optional) CORS allowed origin (Vercel Frontend URL)
# ALLOWED_ORIGIN=https://omega-fuzz-api.vercel.app
